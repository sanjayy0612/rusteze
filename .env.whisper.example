# Copy these exports into your shell profile only if you keep whisper.cpp in a
# non-default location. The setup script uses these same defaults automatically.
export RUSTEZE_WHISPER_CPP_DIR="$PWD/tools/whisper.cpp"
export RUSTEZE_MODEL_DIR="$PWD/models"
export RUSTEZE_WHISPER_MODEL_NAME="large-v3-turbo-q5_0"

# Set after running scripts/setup-whisper-cpp.sh.
export RUSTEZE_WHISPER_CPP_BIN="$RUSTEZE_WHISPER_CPP_DIR/build/bin/whisper-cli"
export RUSTEZE_WHISPER_MODEL="$RUSTEZE_MODEL_DIR/ggml-$RUSTEZE_WHISPER_MODEL_NAME.bin"
